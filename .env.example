# API Key para football-data.org
# Registrate gratis en: https://www.football-data.org/client/register
VITE_FOOTBALL_DATA_API_KEY=tu_api_key_aqui
FOOTBALL_DATA_API_KEY=tu_api_key_aqui

# API Key para Google Gemini (server-side únicamente — sin prefijo VITE_)
# La clave la usa exclusivamente la Netlify Function netlify/functions/gemini.ts
# Configurala en: Netlify → Site settings → Environment variables
# Obtené tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui
# API Key para API-Football (api-sports.io) — usada solo server-side por Netlify Functions
# Configurala en: Netlify → Site settings → Environment variables
API_SPORTS_KEY=tu_clave_de_api-football

# Opcional: activa el proxy serverless de imagenes externas.
# Por defecto queda desactivado para evitar imagenes rotas si la funcion
# /.netlify/functions/image-proxy no esta desplegada en el entorno actual.
VITE_ENABLE_IMAGE_PROXY=false
